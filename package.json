{
  "name": "moon-cards",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 0.0.0.0",
    "build": "node scripts/prepare-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "validate": "node scripts/prepare-assets.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
